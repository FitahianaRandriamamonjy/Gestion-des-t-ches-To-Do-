{% extends 'base.html.twig' %}

{% block title %}{{ task.title }} - TaskFlow{% endblock %}
{% block page_title %}{{ task.title }}{% endblock %}
{% block page_subtitle %}Détails de la tâche{% endblock %}
{% block topbar_actions %}
    <a href="{{ path('task_edit', {id: task.id}) }}" class="df-btn-ghost"><i class="bi bi-pencil"></i> Modifier</a>
    <a href="{{ path('task_index') }}" class="df-btn-primary"><i class="bi bi-arrow-left"></i> Retour</a>
{% endblock %}

{% block body %}
    <div class="df-card">
        <div class="df-badges-row mb-3">
            <span class="df-badge {{ task.priority.value == 'high' ? 'high' : (task.priority.value == 'medium' ? 'medium' : 'low') }}">{{ task.priority.label }}</span>
            <span class="df-status {{ task.isOverdue ? 'overdue' : task.status.value }}"><i></i> {{ task.isOverdue ? 'En retard' : task.status.label }}</span>
        </div>

        <dl class="df-detail-list">
            <dt>Description</dt>
            <dd>{{ task.description ?: 'Aucune description' }}</dd>

            <dt>Échéance</dt>
            <dd>{{ task.dueDate ? task.dueDate|date('d/m/Y H:i') : 'Non définie' }}</dd>

            <dt>Assignée à</dt>
            <dd>
                {% if task.assignedTo %}
                    <span class="df-avatar-sm" style="background:{{ task.assignedTo.fullName|avatar_color }}22; color:{{ task.assignedTo.fullName|avatar_color }};">{{ task.assignedTo.fullName|initials }}</span>
                    {{ task.assignedTo.fullName }}
                {% else %}
                    Non assignée
                {% endif %}
            </dd>

            <dt>Créée par</dt>
            <dd>{{ task.createdBy ? task.createdBy.fullName : '—' }}</dd>

            <dt>Créée le</dt>
            <dd>{{ task.createdAt|date('d/m/Y H:i') }}</dd>

            <dt>Dernière mise à jour</dt>
            <dd>{{ task.updatedAt|date('d/m/Y H:i') }}</dd>
        </dl>
    </div>

    <form method="post" action="{{ path('task_delete', {id: task.id}) }}" class="mt-3"
          onsubmit="return confirm('Supprimer cette tâche ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
        <button type="submit" class="df-btn-danger">
            <i class="bi bi-trash"></i> Supprimer la tâche
        </button>
    </form>
{% endblock %}
